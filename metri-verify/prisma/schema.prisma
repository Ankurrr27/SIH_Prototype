// Legal Metrology Digital Verification & Certification System Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum SystemRole {
  APPLICANT
  LMO
  GATC
  ADMIN
}

enum OrganizationType {
  BUSINESS_APPLICANT
  MANUFACTURER
  REPAIRER
  DEALER
  GATC
  DEPARTMENT
}

enum ApplicationType {
  NEW_VERIFICATION
  RE_VERIFICATION
  REINSPECTION
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_CORRECTION
  APPROVED_FOR_SCHEDULING
  SCHEDULED
  IN_VERIFICATION
  VERIFICATION_COMPLETED
  CERTIFICATE_PENDING
  ISSUED
  REJECTED
  CANCELLED
  REINSPECTION_REQUIRED
}

enum ScheduleStatus {
  SCHEDULED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  REASSIGNED
  CANCELLED
}

enum InspectionStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  SUBMITTED
  APPROVED
  REJECTED
}

enum TestResultStatus {
  PASS
  FAIL
  SKIPPED
}

enum CertificateStatus {
  VALID
  EXPIRED
  REVOKED
}

enum NotificationType {
  APPLICATION_SUBMITTED
  APPLICATION_NEEDS_CORRECTION
  APPLICATION_APPROVED
  VERIFICATION_SCHEDULED
  VERIFICATION_COMPLETED
  CERTIFICATE_ISSUED
  CERTIFICATE_EXPIRING
  CERTIFICATE_EXPIRED
  TASK_ASSIGNED
  TASK_RESCHEDULED
}

// ==========================================
// 1. USER & AUTHENTICATION MODELS
// ==========================================

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  mobile           String?  @unique
  passwordHash     String
  fullName         String
  designation      String?
  district         String?
  state            String?  @default("Delhi")
  isEmailVerified  Boolean  @default(false)
  isMobileVerified Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  roles                   UserRole[]
  organizationMemberships OrganizationMember[]
  instruments             Instrument[]             @relation("InstrumentOwner")
  applications            Application[]            @relation("ApplicantUser")
  reviewedApplications    Application[]            @relation("ReviewerUser")
  assignedByAssignments   Assignment[]             @relation("AssignedByAdmin")
  assignedTasks           Assignment[]             @relation("AssignedOfficer")
  inspections             Inspection[]             @relation("InspectionOfficer")
  issuedCertificates      Certificate[]            @relation("IssuingOfficer")
  notifications           Notification[]
  auditLogs               AuditLog[]
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([email])
  @@index([district])
}

model Role {
  id          String     @id @default(uuid())
  name        SystemRole @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "application:create", "inspection:submit"
  description String?
  module      String // e.g. "applications", "inspections"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 2. ORGANIZATION MODELS
// ==========================================

model Organization {
  id             String           @id @default(uuid())
  name           String
  code           String           @unique
  type           OrganizationType
  registrationNo String?          @unique
  gstin          String?
  address        String
  district       String
  state          String           @default("Delhi")
  pincode        String
  contactEmail   String
  contactPhone   String
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  members         OrganizationMember[]
  gatcAssignments Assignment[]         @relation("AssignedGATC")

  @@index([district])
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  roleInOrg      String   @default("MEMBER") // e.g. "OWNER", "MANAGER", "VERIFIER"
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

// ==========================================
// 3. INSTRUMENT REGISTRY MODELS
// ==========================================

model InstrumentType {
  id                       String   @id @default(uuid())
  code                     String   @unique // e.g. "WEIGHING_SCALE_CLASS_III", "PETROL_PUMP_DISPENSER"
  name                     String
  category                 String // e.g. "Weights & Measures", "Measuring Instruments"
  accuracyClass            String? // e.g. "Class III", "Class II", "Class I"
  verificationPeriodMonths Int      @default(12) // Configurable demo validity period
  description              String?
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  instruments     Instrument[]
  testDefinitions TestDefinition[]
}

model Instrument {
  id                    String    @id @default(uuid())
  typeId                String
  ownerId               String
  manufacturer          String
  model                 String
  serialNumber          String
  capacity              String // e.g. "15 kg", "50 L/min"
  accuracyClass         String?
  unit                  String // e.g. "kg", "g", "L"
  installationLocation  String
  district              String
  state                 String    @default("Delhi")
  purchaseDate          DateTime?
  previousCertificateNo String?
  currentStatus         String    @default("REGISTERED") // REGISTERED, VERIFIED, EXPIRED, UNDER_VERIFICATION
  nextVerificationDue   DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  type         InstrumentType @relation(fields: [typeId], references: [id])
  owner        User           @relation("InstrumentOwner", fields: [ownerId], references: [id])
  applications Application[]
  certificates Certificate[]

  @@unique([serialNumber, manufacturer])
  @@index([ownerId])
  @@index([district])
}

// ==========================================
// 4. APPLICATION WORKFLOW MODELS
// ==========================================

model Application {
  id              String            @id @default(uuid())
  applicationNo   String            @unique
  applicantId     String
  instrumentId    String
  type            ApplicationType   @default(NEW_VERIFICATION)
  status          ApplicationStatus @default(DRAFT)
  submissionDate  DateTime?
  reviewDate      DateTime?
  reviewerId      String?
  rejectionReason String?
  correctionNotes String?
  district        String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  applicant     User                       @relation("ApplicantUser", fields: [applicantId], references: [id])
  reviewer      User?                      @relation("ReviewerUser", fields: [reviewerId], references: [id])
  instrument    Instrument                 @relation(fields: [instrumentId], references: [id])
  documents     ApplicationDocument[]
  statusHistory ApplicationStatusHistory[]
  assignments   Assignment[]
  schedule      Schedule?
  inspection    Inspection?
  certificates  Certificate[]

  @@index([applicantId])
  @@index([status])
  @@index([district])
}

model ApplicationDocument {
  id            String   @id @default(uuid())
  applicationId String
  documentType  String // e.g. "PURCHASE_INVOICE", "PREVIOUS_CERTIFICATE", "CALIBRATION_REPORT"
  fileName      String
  fileKey       String
  fileUrl       String
  mimeType      String
  fileSize      Int
  uploadedAt    DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model ApplicationStatusHistory {
  id            String             @id @default(uuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedById   String?
  remarks       String?
  timestamp     DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

// ==========================================
// 5. SCHEDULING & TASK ALLOCATION MODELS
// ==========================================

model Assignment {
  id            String           @id @default(uuid())
  applicationId String
  assignedById  String
  assignedToId  String? // User ID if assigned to an LMO
  gatcOrgId     String? // Organization ID if assigned to GATC
  status        AssignmentStatus @default(ASSIGNED)
  remarks       String?
  assignedAt    DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  application     Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  assignedBy      User          @relation("AssignedByAdmin", fields: [assignedById], references: [id])
  assignedOfficer User?         @relation("AssignedOfficer", fields: [assignedToId], references: [id])
  assignedGATC    Organization? @relation("AssignedGATC", fields: [gatcOrgId], references: [id])
}

model Schedule {
  id               String         @id @default(uuid())
  applicationId    String         @unique
  scheduledDate    DateTime
  scheduledTime    String // e.g. "10:30 AM"
  location         String
  district         String
  status           ScheduleStatus @default(SCHEDULED)
  rescheduleReason String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

// ==========================================
// 6. INSPECTION & VERIFICATION MODELS
// ==========================================

model TestDefinition {
  id               String   @id @default(uuid())
  instrumentTypeId String
  testCode         String // e.g. "REPEATABILITY_TEST", "MAX_PERMISSIBLE_ERROR_TEST"
  testName         String
  parameterName    String // e.g. "Error at 5kg", "Flow rate error"
  unit             String
  toleranceMin     Float // Demo tolerance min
  toleranceMax     Float // Demo tolerance max
  isRequired       Boolean  @default(true)
  displayOrder     Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  instrumentType InstrumentType @relation(fields: [instrumentTypeId], references: [id], onDelete: Cascade)
  testResults    TestResult[]
}

model Inspection {
  id                  String           @id @default(uuid())
  applicationId       String           @unique
  officerId           String
  verificationDate    DateTime         @default(now())
  location            String
  physicalSealsIntact Boolean          @default(true)
  sealNumbers         String? // Comma-separated seal numbers
  overallResult       TestResultStatus @default(SKIPPED) // PASS or FAIL
  officerRemarks      String?
  status              InspectionStatus @default(DRAFT)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  application Application          @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  officer     User                 @relation("InspectionOfficer", fields: [officerId], references: [id])
  testResults TestResult[]
  evidences   InspectionEvidence[]
}

model TestResult {
  id               String           @id @default(uuid())
  inspectionId     String
  testDefinitionId String
  referenceValue   Float
  observedValue    Float
  errorValue       Float
  unit             String
  result           TestResultStatus
  notes            String?
  createdAt        DateTime         @default(now())

  inspection     Inspection     @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  testDefinition TestDefinition @relation(fields: [testDefinitionId], references: [id])
}

model InspectionEvidence {
  id           String   @id @default(uuid())
  inspectionId String
  caption      String?
  fileName     String
  fileKey      String
  fileUrl      String
  mimeType     String
  fileSize     Int
  uploadedAt   DateTime @default(now())

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
}

// ==========================================
// 7. DIGITAL CERTIFICATE MODELS
// ==========================================

model Certificate {
  id                String            @id @default(uuid())
  certificateNo     String            @unique
  verificationToken String            @unique // Token embedded in public QR code
  tokenHash         String?
  applicationId     String
  instrumentId      String
  issuingOfficerId  String
  issueDate         DateTime          @default(now())
  validFrom         DateTime          @default(now())
  validUntil        DateTime
  status            CertificateStatus @default(VALID)
  revocationReason  String?
  revokedAt         DateTime?
  qrCodeDataUrl     String?
  pdfFileKey        String?
  pdfFileUrl        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  application    Application               @relation(fields: [applicationId], references: [id])
  instrument     Instrument                @relation(fields: [instrumentId], references: [id])
  issuingOfficer User                      @relation("IssuingOfficer", fields: [issuingOfficerId], references: [id])
  revisions      CertificateRevision[]
  verifications  CertificateVerification[]

  @@index([certificateNo])
  @@index([verificationToken])
  @@index([validUntil])
  @@index([status])
}

model CertificateRevision {
  id            String   @id @default(uuid())
  certificateId String
  revisionNo    Int
  changes       String
  reason        String
  revisedById   String
  revisedAt     DateTime @default(now())

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
}

model CertificateVerification {
  id            String   @id @default(uuid())
  certificateId String
  ipAddress     String?
  userAgent     String?
  verifiedAt    DateTime @default(now())

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
}

// ==========================================
// 8. NOTIFICATIONS & AUDIT MODELS
// ==========================================

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String // e.g. "USER_LOGIN", "APPLICATION_SUBMITTED", "CERTIFICATE_ISSUED"
  entityType String // e.g. "Application", "Certificate", "Inspection"
  entityId   String?
  metadata   Json? // Context payload
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
}
